# SHA-256 hex of the app password — never put the password itself here.
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# Copy this file to .env.local for local development.
VITE_AUTH_HASH=

# Firebase Realtime Database. Optional — defaults to the Budget project URL.
VITE_FIREBASE_DATABASE_URL=https://budget-f1d3e-default-rtdb.firebaseio.com
